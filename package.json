{
  "name": "projeto-backend",
  "version": "1.0.0",
  "description": "Para a implementação deste projeto vamo precisar usar as seguintes tecnologias:",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:e2e": "jest --runInBand tests/e2e",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "test:concurrency": "node tests/concurrency-smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcal-Andre/projeto-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Marcal-Andre/projeto-backend/issues"
  },
  "homepage": "https://github.com/Marcal-Andre/projeto-backend#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1"
  },
