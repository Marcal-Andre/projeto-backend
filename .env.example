# Copy this file to .env for local development. Replace every placeholder.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=store_dev
DB_USER=store_app
DB_PASSWORD=replace-with-a-strong-local-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_POOL_MAX=10
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_KEY=replace-with-at-least-64-random-hex-characters-before-starting

# Optional. Set both only when bootstrapping the first administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

MEDIA_DIR=uploads

# Configure these with the credentials from your Mercado Pago application.
# Keep the access token and webhook secret private; never expose them in the frontend.
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_API_URL=
MP_SUCCESS_URL=http://localhost:5173/checkout/sucesso
MP_PENDING_URL=http://localhost:5173/checkout/pendente
MP_FAILURE_URL=http://localhost:5173/checkout/falha
