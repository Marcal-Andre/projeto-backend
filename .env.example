# Copy this file to .env for local development. Replace every placeholder.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DB_NAME=store_dev
DB_USER=store_app
DB_PASSWORD=replace-with-a-strong-local-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_POOL_MAX=10
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_KEY=replace-with-at-least-64-random-hex-characters-before-starting

# Optional. Set both only when bootstrapping the first administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

MEDIA_DIR=uploads
